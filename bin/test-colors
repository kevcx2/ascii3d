#!/usr/bin/env node
'use strict';

// Test script to verify ANSI truecolor support in your terminal.
// Displays the exact shade ramp that ascii3d uses for rendering.

const LIGHT_COLOR   = [255, 200, 150];
const AMBIENT_COLOR = [30,  30,  50];
const BG_COLOR      = [20,  20,  30];
const CHAR          = '&';
const WIDTH         = 60;

function clamp(v) {
  return Math.min(255, Math.max(0, Math.round(v)));
}

function fg(r, g, b) {
  return `\x1b[38;2;${r};${g};${b}m`;
}

function bg(r, g, b) {
  return `\x1b[48;2;${r};${g};${b}m`;
}

const RESET = '\x1b[0m';

// ── Header ──────────────────────────────────────────────────
console.log(`${RESET}\n  ascii3d color test\n`);

// ── 1. Basic truecolor check ────────────────────────────────
console.log('  1) Truecolor gradient (should be a smooth red ramp, no banding):');
process.stdout.write('     ');
for (let i = 0; i < WIDTH; i++) {
  const v = Math.round((i / (WIDTH - 1)) * 255);
  process.stdout.write(`${fg(v, 0, 0)}${CHAR}`);
}
console.log(RESET);

process.stdout.write('     ');
for (let i = 0; i < WIDTH; i++) {
  const v = Math.round((i / (WIDTH - 1)) * 255);
  process.stdout.write(`${fg(0, v, 0)}${CHAR}`);
}
console.log(RESET);

process.stdout.write('     ');
for (let i = 0; i < WIDTH; i++) {
  const v = Math.round((i / (WIDTH - 1)) * 255);
  process.stdout.write(`${fg(0, 0, v)}${CHAR}`);
}
console.log(RESET);

// ── 2. ascii3d shade ramp ───────────────────────────────────
console.log('\n  2) ascii3d diffuse ramp (ambient → full light):');
console.log('     diffuse: 0.0 ──────────────────────────────────── 1.0');
process.stdout.write('     ');
for (let i = 0; i < WIDTH; i++) {
  const d = i / (WIDTH - 1); // diffuse 0..1
  const r = clamp(AMBIENT_COLOR[0] + d * LIGHT_COLOR[0]);
  const g = clamp(AMBIENT_COLOR[1] + d * LIGHT_COLOR[1]);
  const b = clamp(AMBIENT_COLOR[2] + d * LIGHT_COLOR[2]);
  process.stdout.write(`${fg(r, g, b)}${CHAR}`);
}
console.log(RESET);

// ── 3. Cube face simulation ─────────────────────────────────
console.log('\n  3) Simulated cube face shades (what you should see on a cube):');

const lightDir = [0.5, 0.8, 0.6];
const len = Math.sqrt(lightDir[0] ** 2 + lightDir[1] ** 2 + lightDir[2] ** 2);
const ld = lightDir.map(v => v / len);

const faces = [
  { name: 'Top    [0,1,0]',  normal: [0, 1, 0]  },
  { name: 'Front  [0,0,1]',  normal: [0, 0, 1]  },
  { name: 'Right  [1,0,0]',  normal: [1, 0, 0]  },
  { name: 'Left  [-1,0,0]',  normal: [-1, 0, 0] },
  { name: 'Back  [0,0,-1]',  normal: [0, 0, -1] },
  { name: 'Bottom [0,-1,0]', normal: [0, -1, 0] },
];

for (const face of faces) {
  const dot = Math.max(0,
    face.normal[0] * ld[0] +
    face.normal[1] * ld[1] +
    face.normal[2] * ld[2]
  );
  const r = clamp(AMBIENT_COLOR[0] + dot * LIGHT_COLOR[0]);
  const g = clamp(AMBIENT_COLOR[1] + dot * LIGHT_COLOR[1]);
  const b = clamp(AMBIENT_COLOR[2] + dot * LIGHT_COLOR[2]);

  const swatch = `${fg(r, g, b)}${'&&&&&&&&&&&&&&&&'}${RESET}`;
  const rgb = `(${String(r).padStart(3)}, ${String(g).padStart(3)}, ${String(b).padStart(3)})`;
  console.log(`     ${face.name}  ${swatch}  ${rgb}  diffuse=${dot.toFixed(2)}`);
}

// ── 4. Background color ─────────────────────────────────────
console.log(`\n  4) Background color (used in --bg filled mode):`);
process.stdout.write('     ');
for (let i = 0; i < WIDTH; i++) {
  process.stdout.write(`${fg(BG_COLOR[0], BG_COLOR[1], BG_COLOR[2])}${CHAR}`);
}
console.log(RESET);

// ── 5. Side-by-side foreground on background ────────────────
console.log('\n  5) Foreground on background (should be clearly visible):');
process.stdout.write('     ');
const midD = 0.5;
const midR = clamp(AMBIENT_COLOR[0] + midD * LIGHT_COLOR[0]);
const midG = clamp(AMBIENT_COLOR[1] + midD * LIGHT_COLOR[1]);
const midB = clamp(AMBIENT_COLOR[2] + midD * LIGHT_COLOR[2]);
for (let i = 0; i < WIDTH; i++) {
  process.stdout.write(`${bg(BG_COLOR[0], BG_COLOR[1], BG_COLOR[2])}${fg(midR, midG, midB)}${CHAR}`);
}
console.log(RESET);

// ── Summary ─────────────────────────────────────────────────
console.log(`
  If you see:
    - Smooth gradients in test 1        → your terminal supports truecolor
    - A warm-to-cool ramp in test 2     → shade colors are correct
    - Distinct colors per face in test 3 → cube shading will work
    - Visible '&' chars in test 5       → foreground/background contrast OK

  If gradients look banded or all one color, your terminal may not
  support truecolor. Try setting: export COLORTERM=truecolor
`);
