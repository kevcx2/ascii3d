#!/usr/bin/env node
'use strict';

// Test script to verify terminal color support for ascii3d.
// Tests both truecolor (24-bit) and 256-color modes.

const { detectColorMode, rgb256 } = require('../src/output-ansi');

const LIGHT_COLOR   = [180, 180, 180];
const AMBIENT_COLOR = [50,  50,  50];
const BG_COLOR      = [20,  20,  20];
const CHAR          = '&';
const WIDTH         = 60;

function clamp(v) {
  return Math.min(255, Math.max(0, Math.round(v)));
}

function fgTrue(r, g, b) {
  return `\x1b[38;2;${r};${g};${b}m`;
}

function fg256(r, g, b) {
  return `\x1b[38;5;${rgb256(r, g, b)}m`;
}

const RESET = '\x1b[0m';

const detected = detectColorMode();

console.log(`${RESET}`);
console.log(`  ascii3d color test`);
console.log(`  Detected color mode: ${detected}`);
console.log(`    COLORTERM=${process.env.COLORTERM || '(not set)'}`);
console.log(`    TERM=${process.env.TERM || '(not set)'}`);
console.log();

// ── Helper to draw a gradient row with a given fg function ──
function drawGradientRow(label, fgFn, rFn, gFn, bFn) {
  process.stdout.write(`     ${label}: `);
  for (let i = 0; i < WIDTH; i++) {
    const t = i / (WIDTH - 1);
    const r = Math.round(rFn(t));
    const g = Math.round(gFn(t));
    const b = Math.round(bFn(t));
    process.stdout.write(`${fgFn(r, g, b)}${CHAR}`);
  }
  console.log(RESET);
}

// ── Section A: Truecolor (24-bit) ───────────────────────────
console.log('  A) TRUECOLOR mode (\\x1b[38;2;R;G;Bm):');
drawGradientRow('  Red', fgTrue, t => t * 255, () => 0, () => 0);
drawGradientRow('Green', fgTrue, () => 0, t => t * 255, () => 0);
drawGradientRow(' Blue', fgTrue, () => 0, () => 0, t => t * 255);

// ── Section B: 256-color ────────────────────────────────────
console.log('\n  B) 256-COLOR mode (\\x1b[38;5;Nm):');
drawGradientRow('  Red', fg256, t => t * 255, () => 0, () => 0);
drawGradientRow('Green', fg256, () => 0, t => t * 255, () => 0);
drawGradientRow(' Blue', fg256, () => 0, () => 0, t => t * 255);

// ── Section C: Diffuse ramp in both modes ───────────────────
console.log('\n  C) ascii3d diffuse ramp (ambient → full light):');
function diffuseR(t) { return clamp(AMBIENT_COLOR[0] + t * LIGHT_COLOR[0]); }
function diffuseG(t) { return clamp(AMBIENT_COLOR[1] + t * LIGHT_COLOR[1]); }
function diffuseB(t) { return clamp(AMBIENT_COLOR[2] + t * LIGHT_COLOR[2]); }
drawGradientRow('truecolor', fgTrue, diffuseR, diffuseG, diffuseB);
drawGradientRow('  256-col', fg256, diffuseR, diffuseG, diffuseB);

// ── Section D: Cube face swatches ───────────────────────────
console.log('\n  D) Cube face shades (truecolor left, 256-color right):');

const lightDir = [0.5, 0.8, 0.6];
const len = Math.sqrt(lightDir[0] ** 2 + lightDir[1] ** 2 + lightDir[2] ** 2);
const ld = lightDir.map(v => v / len);

const faces = [
  { name: 'Top    [0,1,0]',  normal: [0, 1, 0]  },
  { name: 'Front  [0,0,1]',  normal: [0, 0, 1]  },
  { name: 'Right  [1,0,0]',  normal: [1, 0, 0]  },
  { name: 'Left  [-1,0,0]',  normal: [-1, 0, 0] },
  { name: 'Back  [0,0,-1]',  normal: [0, 0, -1] },
  { name: 'Bottom [0,-1,0]', normal: [0, -1, 0] },
];

for (const face of faces) {
  const dot = Math.max(0,
    face.normal[0] * ld[0] +
    face.normal[1] * ld[1] +
    face.normal[2] * ld[2]
  );
  const r = clamp(AMBIENT_COLOR[0] + dot * LIGHT_COLOR[0]);
  const g = clamp(AMBIENT_COLOR[1] + dot * LIGHT_COLOR[1]);
  const b = clamp(AMBIENT_COLOR[2] + dot * LIGHT_COLOR[2]);

  const swatchTrue = `${fgTrue(r, g, b)}${'&&&&&&&&'}${RESET}`;
  const swatch256  = `${fg256(r, g, b)}${'&&&&&&&&'}${RESET}`;
  const rgb = `(${String(r).padStart(3)}, ${String(g).padStart(3)}, ${String(b).padStart(3)})`;
  console.log(`     ${face.name}  ${swatchTrue} ${swatch256}  ${rgb}  d=${dot.toFixed(2)}`);
}

// ── Summary ─────────────────────────────────────────────────
console.log(`
  Look at the gradients above:
    Section A smooth  → truecolor works, use: --color truecolor
    Section A banded  → truecolor NOT supported
    Section B stepped → 256-color works (expected: 6 steps per channel)

  ascii3d auto-detected: "${detected}" for your terminal.
  Override with: node bin/ascii3d model.obj --color 256
                 node bin/ascii3d model.obj --color truecolor
`);
